# Pioneer (transcript -> structured service tasks)
PIONEER_API_KEY=
PIONEER_API_URL=https://api.pioneer.ai/v1/chat/completions
PIONEER_MODEL_ID=c71c07b1-3dd6-42fa-b093-76e5c35fc347

# ── Demo auth (single user for integrations demo) ────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string
DEMO_USER_EMAIL=you@example.com
DEMO_USER_PASSWORD=change-me
DEMO_USER_NAME=Demo User

# ── Google OAuth (Calendar + Gmail) ────────────────────────────────────────────
# Create credentials: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
# Scopes include Gmail read/send/modify and Calendar events.
# If you connected Google before inbox access was added, disconnect and reconnect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: directory for encrypted Google OAuth token persistence (default: .data/)
# GOOGLE_TOKEN_STORE_PATH=

# ── Video -> transcript ──────────────────────────────────────────────────────
# Pick ONE provider. If none configured, a stub transcript is used.
#
# Option A — Gemini (recommended: true multimodal, sees video + hears audio)
#   Get a key: https://aistudio.google.com/apikey
#   TRANSCRIPTION_PROVIDER=gemini
#   GEMINI_API_KEY=your_key_here
#   TRANSCRIPTION_MODEL=gemini-2.5-flash
#
# Option B — OpenAI Whisper (audio only, very reliable for German speech)
#   TRANSCRIPTION_PROVIDER=openai
#   OPENAI_API_KEY=your_key_here
#   TRANSCRIPTION_MODEL=whisper-1
#   TRANSCRIPTION_LANGUAGE=de
#
# Option C — Custom endpoint (your own transcription service)
#   TRANSCRIPTION_PROVIDER=custom
#   TRANSCRIPTION_API_URL=https://your-service/transcribe
#   TRANSCRIPTION_API_KEY=your_key_here

TRANSCRIPTION_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=
TRANSCRIPTION_LANGUAGE=de

# Legacy custom endpoint (used when provider=custom)
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=

# ── Tavily (web search for purchase prices) ───────────────────────────────────
# Get a key: https://tavily.com
# Without a key, placeholder retailer prices are returned for development.
TAVILY_API_KEY=

# ── fal (action planning after tasks are created) ─────────────────────────────
# Get a key: https://fal.ai/dashboard/keys
# Runs only after Pioneer extraction — drafts email, calendar, price, demo actions.
# Without a key, rule-based action drafts are used.
FAL_API_KEY=
FAL_MODEL=google/gemini-2.5-flash-lite

# ── Neon Postgres (device metadata + video catalog) ───────────────────────────
# Create a project at https://console.neon.tech and paste the connection string.
DATABASE_URL=

# ── Cloudflare R2 (video file storage) ────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
